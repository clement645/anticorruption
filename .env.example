# ==============================================================================
# B-PFMPS Environment Configuration (EXAMPLE — copy to .env and fill in real values)
# NEVER commit the real .env file. NEVER commit real secrets.
# ==============================================================================

# ------------------------------------------------------------------------------
# PRIVATE — Backend (apps/api) only. Never expose these to the frontend/browser.
# ------------------------------------------------------------------------------

# Runtime
NODE_ENV=development
PORT=3000
API_PREFIX=api/v1

# Database (Neon PostgreSQL) — use the pooled connection string for the app,
# and the direct (non-pooled) connection string for migrations. Phase 14 load
# testing found Prisma's default connection pool (num_cpus*2+1) saturates and
# queues under realistic concurrency, more than doubling p50 latency and
# collapsing throughput on a DB-touching endpoint — set connection_limit
# explicitly (start from Neon's own per-role connection ceiling on the
# pooled endpoint, divided across however many app instances share it) rather
# than relying on the default. See DEPLOYMENT.md § Load Testing & Capacity.
DATABASE_URL="postgresql://user:password@ep-example-pooler.region.aws.neon.tech/bpfmps?sslmode=require&connection_limit=20&pool_timeout=10"
DIRECT_DATABASE_URL="postgresql://user:password@ep-example.region.aws.neon.tech/bpfmps?sslmode=require"

# Auth secrets (generate with: openssl rand -base64 64)
JWT_SECRET=
JWT_ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=7
ACCOUNT_LOCKOUT_THRESHOLD=5
ACCOUNT_LOCKOUT_DURATION_MINUTES=15

# MFA TOTP secret encryption key (generate with: openssl rand -base64 32)
MFA_ENCRYPTION_KEY=

# Immutable audit chain signing key (Ed25519, base64-encoded PEM). Generate with:
#   node -e "const c=require('@bpfmps/crypto');const k=c.generateEd25519KeyPair();console.log('AUDIT_SIGNING_PRIVATE_KEY='+Buffer.from(k.privateKeyPem).toString('base64'));console.log('AUDIT_SIGNING_PUBLIC_KEY='+Buffer.from(k.publicKeyPem).toString('base64'));"
AUDIT_SIGNING_PRIVATE_KEY=
AUDIT_SIGNING_PUBLIC_KEY=
AUDIT_SIGNING_KEY_ID=audit-key-1

# Application-level encryption (evidence, sensitive PII fields) — 32-byte key, base64
ENCRYPTION_KEY=

# CORS — comma-separated list of allowed origins
CORS_ORIGIN=http://localhost:5173

# Blockchain integrity layer — Phase 4 ships only the development ledger
# adapter (a self-contained, hash-chained ledger simulation stored in
# PostgreSQL — no external network). BLOCKCHAIN_ADAPTER has no other valid
# value yet; RPC_URL/PRIVATE_KEY are reserved for a future
# PermissionedBlockchainAdapter (Hyperledger Fabric/Besu) and are unused today.
BLOCKCHAIN_ADAPTER=development
BLOCKCHAIN_ANCHOR_INTERVAL_SECONDS=60
BLOCKCHAIN_ANCHOR_BATCH_SIZE=100
BLOCKCHAIN_RPC_URL=
BLOCKCHAIN_PRIVATE_KEY=

# AI Risk Engine (Phase 8) — split-procurement detector policy thresholds
RISK_SPLIT_PROCUREMENT_THRESHOLD=1000000
RISK_SPLIT_PROCUREMENT_WINDOW_DAYS=30
RISK_SPLIT_PROCUREMENT_MIN_COUNT=3

# Object storage / evidence vault — Phase 10 ships a real local implementation
# (encrypted files actually stored and retrievable on disk, not just a hash of
# them — see schema.prisma comment on ProjectEvidence), the same
# "prove it against a real local stand-in, swappable later" judgment already
# made for DATABASE_URL (local Postgres vs Neon) and BLOCKCHAIN_ADAPTER (the
# development ledger vs a future permissioned chain). OBJECT_STORAGE_ADAPTER
# has no other valid value yet; ENDPOINT/REGION/BUCKET/ACCESS_KEY/SECRET_KEY
# are reserved for a future S3-compatible adapter and are unused today.
OBJECT_STORAGE_ADAPTER=filesystem
EVIDENCE_STORAGE_PATH=./storage/evidence
EVIDENCE_ENCRYPTION_KEY=
OBJECT_STORAGE_ENDPOINT=
OBJECT_STORAGE_REGION=
OBJECT_STORAGE_BUCKET=
OBJECT_STORAGE_ACCESS_KEY=
OBJECT_STORAGE_SECRET_KEY=

# Whistleblower Portal (Phase 13) — a dedicated key for the one genuinely
# identifying field this module can ever hold (an optional reporter contact),
# deliberately separate from EVIDENCE_ENCRYPTION_KEY/MFA_ENCRYPTION_KEY.
# Generate with: openssl rand -base64 32
WHISTLEBLOWER_CONTACT_ENCRYPTION_KEY=

# Rate limiting
RATE_LIMIT_TTL=60
RATE_LIMIT_MAX=100

# Logging
LOG_LEVEL=info

# ------------------------------------------------------------------------------
# PUBLIC — Frontend (apps/web) build-time variables. Safe to expose in the browser.
# Vite only exposes variables prefixed with VITE_.
# ------------------------------------------------------------------------------
VITE_API_BASE_URL=http://localhost:3000/api/v1
VITE_APP_NAME="B-PFMPS"
VITE_APP_ENV=development
